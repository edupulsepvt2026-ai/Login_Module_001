# ============================================
# Multi-Tenant Database Auth Service Config
# ============================================

# Server Configuration
PORT=8080

# Master Database Configuration (Constant Connection)
# This database stores credentials for all tenant databases
MASTER_DB_HOST=localhost
MASTER_DB_PORT=5432
MASTER_DB_NAME=master_db
MASTER_DB_USER=postgres
MASTER_DB_PASSWORD=your_secure_password

# Redis Configuration
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_ACCESS_EXPIRY_SECONDS=900       # 15 minutes
JWT_REFRESH_EXPIRY_SECONDS=604800   # 7 days

# Tenant Pool Configuration
# Expiry duration in minutes - pool will be removed after this time of inactivity
# This is configurable and commonly changed without code changes
TENANT_POOL_EXPIRY_MINUTES=30

# ============================================
# Notes:
# ============================================
# 1. Master DB must have 'coresetting' table with tenant credentials
# 2. Tenant pool expiry can be changed without redeployment (restart required)
# 3. Each vendor gets own connection pool managed by mid
# 4. Pool expires after TENANT_POOL_EXPIRY_MINUTES of creation
# 5. Expired pools are cleaned up automatically every 5 minutes
